generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  student
  instructor
  admin
}

enum BookingStatus {
  confirmed
  completed
  cancelled
}

enum CarStatus {
  available
  unavailable
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                String           @id @default(cuid())
  name              String
  email             String           @unique
  passwordHash      String
  role              Role             @default(student)
  phone             String?
  quizBest          Int?
  studentLessons    Booking[]        @relation("StudentBookings")
  instructorLessons Booking[]        @relation("InstructorBookings")
  slots             InstructorSlot[]
  sentMessages      Message[]        @relation("SentMessages")
  receivedMessages  Message[]        @relation("ReceivedMessages")
  payments          Payment[]        @relation("StudentPayments")
  reviewedPayments  Payment[]        @relation("PaymentReviewer")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model Booking {
  id           String        @id @default(cuid())
  studentId    String
  instructorId String
  carId        String?
  date         DateTime
  time         String
  status       BookingStatus @default(confirmed)
  paid         Boolean       @default(false)
  feedback     String?       @db.Text
  rating       Int?
  student      User          @relation("StudentBookings", fields: [studentId], references: [id], onDelete: Cascade)
  instructor   User          @relation("InstructorBookings", fields: [instructorId], references: [id], onDelete: Cascade)
  car          Car?          @relation(fields: [carId], references: [id], onDelete: SetNull)
  payments     Payment[]
  createdAt    DateTime      @default(now())

  @@index([date, time])
  @@index([studentId, date])
  @@index([instructorId, date])
}

model Payment {
  id                 String        @id @default(cuid())
  studentId          String
  bookingId          String
  packageId          String?
  purpose            String
  amount             Decimal       @db.Decimal(10, 2)
  currency           String        @default("ZAR")
  method             String
  reference          String
  proofFileUrl       String?
  submittedByStudent Boolean       @default(true)
  status             PaymentStatus @default(PENDING)
  adminNote          String?       @db.Text
  reviewedBy         String?
  reviewedAt         DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  booking            Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  student            User          @relation("StudentPayments", fields: [studentId], references: [id], onDelete: Cascade)
  reviewer           User?         @relation("PaymentReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([studentId, createdAt])
  @@index([status, createdAt])
  @@index([bookingId])
}

model Car {
  id       String    @id @default(cuid())
  make     String
  model    String
  plate    String    @unique
  status   CarStatus @default(available)
  bookings Booking[]
}

model InstructorSlot {
  id           String   @id @default(cuid())
  instructorId String
  date         DateTime
  time         String
  isBooked     Boolean  @default(false)
  instructor   User     @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@unique([instructorId, date, time])
  @@index([date, isBooked])
}

model Message {
  id         String   @id @default(cuid())
  fromUserId String
  toUserId   String
  text       String   @db.Text
  createdAt  DateTime @default(now())
  read       Boolean  @default(false)
  fromUser   User     @relation("SentMessages", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser     User     @relation("ReceivedMessages", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([fromUserId, toUserId, createdAt])
}

model K53Note {
  id    String @id @default(cuid())
  title String
  body  String @db.Text
  order Int    @unique
}
